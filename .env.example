# Copy to .env for local development. Ports match docker-compose.yml.
DATABASE_URL=postgres://hookrelay:hookrelay@localhost:5433/hookrelay
REDIS_URL=redis://localhost:6380
API_PORT=3000
# Bearer token for the admin API and dashboard. Change it for anything but local dev.
ADMIN_TOKEN=dev-admin-token
WORKER_CONCURRENCY=20
LOG_LEVEL=info
